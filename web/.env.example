# Copy to .env.local and fill in. Never commit .env.local.

# Supabase: Project Settings -> API Keys (or `pnpm exec supabase status` for local dev)
SUPABASE_URL=http://127.0.0.1:54321
# Secret key (sb_secret_...) — server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Google Gemini: https://aistudio.google.com/apikey  (vision M1/M3/M4 + embeddings)
GEMINI_API_KEY=
# Optional: extra Gemini keys (comma-separated), tried when a key hits its quota (429).
# Quota is per Google Cloud project, so each key must come from a different project.
GEMINI_API_KEYS=
GEMINI_VISION_MODEL=gemini-3.8-flash
# Optional: backup vision models (comma-separated), tried in order when the main model is slow or overloaded.
# Older models are often less busy, e.g. gemini-3.5-flash,gemini-3.1-flash-lite
GEMINI_VISION_FALLBACK_MODELS=
# Optional: ms to wait for the main vision model before also starting the backup (default 5000).
GEMINI_HEDGE_MS=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Groq: https://console.groq.com/keys  (primary text AI: bilingual explanations, officer copilot)
GROQ_API_KEY=
# Optional: extra Groq keys (comma-separated), tried when a key hits its rate limit.
GROQ_API_KEYS=
GROQ_TEXT_MODEL=openai/gpt-oss-120b

# GLM / Zhipu: https://open.bigmodel.cn  (fallback text AI if Groq fails; thinking is disabled in code)
GLM_API_KEY=
GLM_API_BASE=https://open.bigmodel.cn/api/paas/v4
GLM_TEXT_MODEL=glm-4.7-flash
# Optional, only for models that always think (e.g. glm-5.3-flash, which needs a Zhipu balance or
# resource package): low, high or max. Leave empty for glm-4.7-flash.
GLM_REASONING_EFFORT=

# Optional: start date (YYYY-MM-DD, Dhaka time) for the figures on /impact, e.g. the day real testing began.
# Leave empty to count all records. A page link can override it: /impact?since=2026-10-25
KPI_SINCE=

# MCP: read-only Streamable HTTP at /api/mcp. Disabled until a token of at least 32 characters is set.
# Generate a separate random token; never reuse the Supabase or AI provider keys.
MCP_AUTH_TOKEN=
# Only needed for clients that send Origin. Comma-separated exact origins; absent Origin is allowed with a valid token.
MCP_ALLOWED_ORIGINS=
# Smoke-test target; local by default. Use HTTPS for a deployed endpoint.
MCP_URL=http://127.0.0.1:3000/api/mcp
