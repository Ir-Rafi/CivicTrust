{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "seed:fetch": "tsx scripts/fetch-osm.ts",
    "seed:load": "tsx --env-file=.env.local scripts/load-seed.ts",
    "seed:policy": "tsx --env-file=.env.local scripts/embed-policy.ts",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "smoke:ai": "tsx --conditions=react-server --env-file=.env.local scripts/smoke-ai.ts",
    "backfill:areas": "tsx --conditions=react-server --env-file=.env.local scripts/backfill-areas.ts",
    "kpi": "tsx --conditions=react-server --env-file=.env.local scripts/kpi.ts",
    "eval:photos": "tsx --conditions=react-server --env-file=.env.local scripts/eval-photos.ts"
  },
  "dependencies": {
    "@google/genai": "^2.30.0",
    "@supabase/supabase-js": "^2.118.0",
    "clsx": "^2.1.1",
    "exifr": "^7.1.3",
    "groq-sdk": "^1.6.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.58.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/geojson": "^7946.0.16",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "osmtogeojson": "3.0.0-beta.5",
    "supabase": "^2.121.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  }
}
